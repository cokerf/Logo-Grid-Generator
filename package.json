{
  "name": "logo-grid-generator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:plugin",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:plugin": "vite build --mode plugin && node scripts/build-plugin.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --experimental-strip-types --test tests/unit.ts",
    "test:browser": "node scripts/test.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "mp4-muxer": "^5.2.2",
    "paper": "^0.17.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@types/dom-webcodecs": "^0.1.19",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
